# Hopla environment variables. Nothing is required for local development:
# without RESEND_API_KEY, magic links are printed to the console.
# In production, set them in the server environment (for example a file read by
# Docker Compose), never in the repository.

# --- Server ---
# PORT=3000
# SQLite database file. Default: .data/liens.db locally, /data/liens.db in production.
# LIENS_DB=/data/liens.db
# Empty: open sign-up from the landing page. "attente": waitlist, manual invitations.
# LIENS_INSCRIPTION=

# --- Instance, read at startup (a restart applies changes) ---
# Without LIENS_ORIGINE, the instance assumes it is hopla.page.
# Public URL of the instance (required), including https://. Pages at /<username>, admin panel at /admin.
LIENS_ORIGINE=https://links.example.org
# Optional: serve the admin panel on another hostname. Empty: same hostname as the pages.
# LIENS_ORIGINE_ADMIN=https://app.links.example.org
# Legal identity, used in the legal notice, terms of service and privacy policy.
LIENS_EDITEUR=Example Ltd, 1 Example Street, 75002 Paris, RCS Paris 000 000 000
LIENS_HEBERGEUR=Hosting provider name and address
LIENS_DIRECTEUR=First Last
LIENS_CONTACT_LEGAL=contact@example.org
# Your fork, if you modified the code (AGPL-3.0): target of the "Code source" link.
# LIENS_DEPOT_SOURCE=https://github.com/you/hopla

# --- Main account (instance administrator) ---
# Sign-in email address (required), also receives abuse reports.
LIENS_ADMIN_EMAIL=admin@example.org
# Username, set when the database is created (default: "moi").
LIENS_PSEUDO_PRINCIPAL=admin
# CONTACT_TO=admin@example.org

# --- Email delivery (Resend) ---
# Without a key, only the administrator can sign in: the magic link is written to the server logs.
# RESEND_API_KEY=
# Sender address, on a domain verified in Resend.
# CONTACT_FROM=signin@example.org

# --- Encryption of API credentials, webhooks and subscribers (strongly recommended) ---
# openssl rand -base64 32. Never change or remove it once set.
# LIENS_CLE_INTEGRATIONS=

# --- Bot protection (Cloudflare Turnstile, optional: set both or neither) ---
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
# "exclusif": reject any request that does not come through Cloudflare.
# LIENS_CLOUDFLARE=

# --- Billing (Creem, optional) ---
# Without Creem, nothing is sold: every account gets all features, including the API and MCP server.
# CREEM_API_KEY=
# CREEM_WEBHOOK_SECRET=
# CREEM_PRODUIT_MOIS=
# CREEM_PRODUIT_AN=
# CREEM_TEST=1

# --- Background jobs (set to 0 to disable) ---
# HOPLA_RESUMES=0           weekly summary email (Mondays)
# HOPLA_ESSAI_COURRIELS=0   trial ending reminders
# HOPLA_AVIS=0              daily refresh of review ratings
# HOPLA_FAVICONS=0          one-time refresh of link thumbnails

# --- Specific to the hopla.page main page, leave empty elsewhere ---
# LIENS_SITE=
