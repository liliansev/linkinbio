      "html": "<div class=\"ds-lignes\"><div class=\"ds-ligne\"><span class=\"ds-ligne-texte\"><span class=\"ds-ligne-nom\">Adresse</span><span class=\"ds-ligne-valeur\">hopla.page/sarah-coach</span></span><button type=\"button\" class=\"ds-ligne-bouton\">Copier</button></div><button type=\"button\" class=\"ds-ligne ds-ligne-lien\"><span class=\"ds-ligne-texte\"><span class=\"ds-ligne-nom\">Mes stats par e-mail chaque lundi</span></span><span class=\"ds-badge\">Starter</span><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"m6 4 4 4-4 4\"/></svg></button></div>",
      "css": ".ds-lignes{font-family:'Geist Variable',ui-sans-serif,system-ui,sans-serif;width:560px;max-width:100%;border:1px solid #e3e3df;border-radius:12px;background:#fff;color:#0a0a0a}.ds-ligne{display:flex;align-items:center;gap:12px;width:100%;min-height:56px;padding:6px 8px 6px 16px;border:0;background:transparent;color:inherit;font:inherit;font-size:15px;text-align:left}.ds-ligne+.ds-ligne{border-top:1px solid #efefec}.ds-ligne-lien{padding-right:12px;border-radius:0 0 11px 11px;transition:background-color 150ms}.ds-ligne-lien:hover{background:#fafaf9}.ds-ligne-texte{display:flex;flex:1;min-width:0;flex-direction:column}.ds-ligne-valeur{color:#5f5f5a;font-size:13.5px}.ds-ligne-bouton{min-height:36px;padding:0 14px;border:1px solid rgba(10,10,10,.15);border-radius:8px;background:#fff;color:#0a0a0a;font:inherit;font-size:13.5px;font-weight:500}.ds-badge{padding:2px 6px;border-radius:5px;background:rgba(10,10,10,.07);font-size:11.5px;font-weight:600}.ds-ligne:focus-visible,.ds-ligne-bouton:focus-visible{outline:2px solid var(--adm-bleu,#292bff);outline-offset:-2px}@media(min-width:640px){.ds-ligne-texte{flex-direction:row;gap:16px}.ds-ligne-valeur{flex:1;overflow:hidden;font-size:inherit;text-align:right;text-overflow:ellipsis;white-space:nowrap}}@media(min-width:1024px) and (pointer:fine){.ds-ligne{min-height:48px;font-size:13.5px}}@media(prefers-reduced-motion:reduce){.ds-ligne-lien{transition:none}}"
