  "components": [
    {
      "name": "Bouton principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Action principale du back office, en bleu Hopla (blanc dessus, 7,3:1) ; au bureau, 36 px de haut, arrondi de 8 px, graisse moyenne.",
      "html": "<button type=\"button\" class=\"ds-primary\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 256 256\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M224,128a8,8,0,0,1-8,8H136v80a8,8,0,0,1-16,0V136H40a8,8,0,0,1,0-16h80V40a8,8,0,0,1,16,0v80h80A8,8,0,0,1,224,128Z\"/></svg>Ajouter un bloc</button>",
      "css": ".ds-primary{font-family:'Geist Variable',ui-sans-serif,system-ui,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 20px;border:0;border-radius:12px;background:var(--adm-bleu,#292bff);color:#fff;font-size:14px;font-weight:600;transition:background-color 150ms,transform 150ms}.ds-primary:hover{background:var(--adm-bleu-fonce,#1d1fd6)}.ds-primary:focus-visible{outline:2px solid var(--adm-bleu,#292bff);outline-offset:2px;}.ds-primary:active{transform:scale(.98)}.ds-primary:disabled{opacity:.5}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}@media(min-width:1024px) and (pointer:fine){.ds-primary{min-height:36px;padding:0 14px 0 12px;border-radius:8px;font-size:13.5px;font-weight:500;gap:6px}}"
    },
    {
      "name": "Bouton secondaire",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Action complémentaire bordée ; au bureau, 36 px et arrondi de 8 px.",
      "html": "<button type=\"button\" class=\"ds-secondary\">Personnaliser</button>",
      "css": ".ds-secondary{font-family:'Geist Variable',ui-sans-serif,system-ui,sans-serif;min-height:44px;padding:0 16px;border:1px solid #deded9;border-radius:12px;background:var(--adm-surface,#fff);color:var(--color-white,#0a0a0a);font-size:14px;font-weight:500;transition:background-color 150ms,border-color 150ms,transform 150ms}.ds-secondary:hover{background:#f4f4f0;border-color:#c7c7c0}.ds-secondary:focus-visible{outline:2px solid var(--adm-bleu,#292bff);outline-offset:2px;}.ds-secondary:active{transform:scale(.98)}.ds-secondary:disabled{opacity:.5}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}@media(min-width:1024px) and (pointer:fine){.ds-secondary{min-height:36px;padding:0 12px;border-radius:8px;font-size:13.5px}}"
    },
    {
      "name": "Bouton danger",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Effacement définitif, après une confirmation ; le seul bouton rouge.",
      "html": "<button type=\"button\" class=\"ds-danger\">Supprimer définitivement</button>",
      "css": ".ds-danger{font-family:'Geist Variable',ui-sans-serif,system-ui,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 16px;border:0;border-radius:12px;background:#c62828;color:#fff;font-size:14px;font-weight:600;transition:background-color 150ms,transform 150ms}.ds-danger:hover{background:#a51f1f}.ds-danger:focus-visible{outline:2px solid var(--adm-bleu,#292bff);outline-offset:2px;}.ds-danger:active{transform:scale(.98)}.ds-danger:disabled{opacity:.4}@media(prefers-reduced-motion:reduce){.ds-danger{transition:none}}@media(min-width:1024px) and (pointer:fine){.ds-danger{min-height:36px;padding:0 12px;border-radius:8px;font-size:13.5px;font-weight:500}}"
    },
    {
      "name": "Bouton discret",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Annuler, Plus tard, Me déconnecter : du texte secondaire sans fond.",
      "html": "<button type=\"button\" class=\"ds-quiet\">Plus tard</button>",
      "css": ".ds-quiet{font-family:'Geist Variable',ui-sans-serif,system-ui,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:44px;padding:0 12px;border:0;border-radius:12px;background:transparent;color:#666;font-size:14px;font-weight:500;transition:background-color 150ms,color 150ms}.ds-quiet:hover{background:#f4f4f0;color:#0a0a0a}.ds-quiet:focus-visible{outline:2px solid var(--adm-bleu,#292bff);outline-offset:2px;}.ds-quiet:disabled{opacity:.5}@media(prefers-reduced-motion:reduce){.ds-quiet{transition:none}}@media(min-width:1024px) and (pointer:fine){.ds-quiet{min-height:36px;padding:0 10px;border-radius:8px;font-size:13.5px}}"
    },
    {
      "name": "Bouton icône",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "Fermer, revenir ou retirer : un carré de 44 px au picto secondaire, 32 px au bureau.",
      "html": "<button type=\"button\" class=\"ds-icon\" aria-label=\"Fermer\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 256 256\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z\"/></svg></button>",
      "css": ".ds-icon{display:grid;place-items:center;width:44px;height:44px;flex-shrink:0;border:0;border-radius:12px;background:transparent;color:#666;transition:background-color 150ms,color 150ms}.ds-icon:hover{background:#f4f4f0;color:#0a0a0a}.ds-icon:focus-visible{outline:2px solid var(--adm-bleu,#292bff);outline-offset:2px;}@media(prefers-reduced-motion:reduce){.ds-icon{transition:none}}@media(min-width:1024px) and (pointer:fine){.ds-icon{width:32px;height:32px;border-radius:8px}}"
    },
    {
      "name": "Champ de saisie",
      "kind": "input",
      "refersTo": "field",
      "description": "Champ nommé avec saisie lisible sur téléphone ; au bureau, 40 px, arrondi de 8 px, texte de 13,5 px.",
      "html": "<label class=\"ds-label\">Adresse e-mail<input class=\"ds-field\" type=\"email\" placeholder=\"toi@exemple.fr\" /></label>",
      "css": ".ds-label{font-family:'Geist Variable',ui-sans-serif,system-ui,sans-serif;display:block;color:#666;font-size:12.5px;font-weight:500}.ds-field{font-family:'Geist Variable',ui-sans-serif,system-ui,sans-serif;display:block;width:240px;max-width:100%;min-height:48px;margin-top:6px;padding:12px 14px;border:1px solid rgb(10 10 10 / .15);border-radius:12px;background:#fdfdfc;color:var(--color-white,#0a0a0a);font-size:16px;transition:border-color 150ms}.ds-field::placeholder{color:#737373}.ds-field:hover{border-color:#b2b2ab}.ds-field:focus{border-color:rgb(10 10 10 / .7)}.ds-field:focus-visible{outline:2px solid var(--adm-bleu,#292bff);outline-offset:2px;}.ds-field[aria-invalid=true]{border-color:#c62828}@media(prefers-reduced-motion:reduce){.ds-field{transition:none}}@media(min-width:1024px) and (pointer:fine){.ds-label{font-size:12px}.ds-field{min-height:40px;padding:8px 12px;border-radius:8px;font-size:13.5px}}"
    },
    {
      "name": "Navigation de section",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Navigation du bureau, sur le bleu Hopla : rangées de 32 px à la souris (44 au doigt), noms en blanc teinté de bleu (5,4:1), onglet courant en pastille blanche au texte bleu, survol en voile blanc, focus citron.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Sections\"><button type=\"button\" aria-current=\"page\" class=\"ds-nav-item\">Ma page<span class=\"ds-count\">4</span></button><button type=\"button\" class=\"ds-nav-item\">Statistiques</button><button type=\"button\" class=\"ds-nav-item\">Réglages</button></nav>",
      "css": ".ds-nav{display:grid;gap:2px;width:196px;padding:6px 10px 10px;background:var(--adm-bleu,#292bff)}.ds-nav-item{font-family:'Geist Variable',ui-sans-serif,system-ui,sans-serif;display:flex;align-items:center;gap:10px;min-height:44px;padding:0 10px;border:0;border-radius:7px;background:transparent;color:#dcdcff;font-size:14px;font-weight:500;text-align:left;transition:background-color 150ms,color 150ms}.ds-nav-item:hover{background:rgb(255 255 255 / .1);color:#fff}.ds-nav-item[aria-current=page]{background:#fff;color:var(--adm-bleu,#292bff);font-weight:600}.ds-nav-item:focus-visible{outline:2px solid var(--adm-citron,#e3fc96);outline-offset:2px}@media(min-width:1024px) and (pointer:fine){.ds-nav-item{min-height:32px;font-size:13.5px}}@media(prefers-reduced-motion:reduce){.ds-nav-item{transition:none}}"
