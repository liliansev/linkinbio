    {
      "name": "Interrupteur",
      "kind": "custom",
      "refersTo": "switch",
      "description": "État de préférence, cible étendue autour de la piste ; allumée, la piste est bleue ; éteinte, la piste reste à 3:1 sur le papier. Au bureau, 32 sur 18.",
      "html": "<button class=\"ds-switch\" type=\"button\" role=\"switch\" aria-checked=\"true\" aria-label=\"Mes stats par e-mail chaque lundi\"><span class=\"ds-knob\"></span></button>",
      "css": ".ds-switch{position:relative;width:40px;height:24px;border:0;border-radius:9999px;background:rgb(10 10 10 / .45);transition:background-color 220ms ease}.ds-switch::before{position:absolute;inset:-8px;content:\"\"}.ds-switch[aria-checked=true]{background:var(--adm-bleu,#292bff)}.ds-knob{position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:9999px;background:var(--color-nuit,#fff);box-shadow:0 1px 3px rgba(0,0,0,.3);transform-origin:left center;transition:translate 280ms cubic-bezier(.16,1,.3,1),scale 200ms cubic-bezier(.16,1,.3,1)}.ds-switch[aria-checked=true] .ds-knob{translate:16px 0}.ds-switch:focus-visible{outline:2px solid var(--adm-bleu,#292bff);outline-offset:2px;}.ds-switch:active .ds-knob{scale:1.5 1}.ds-switch[aria-checked=true]:active .ds-knob{translate:7px 0}.ds-switch:disabled{opacity:.4}@media(prefers-reduced-motion:reduce){.ds-switch,.ds-knob{transition:none}}@media(min-width:1024px) and (pointer:fine){.ds-switch{width:32px;height:18px}.ds-knob{top:2px;left:2px;width:14px;height:14px}.ds-switch[aria-checked=true] .ds-knob{translate:14px 0}}"
    },
